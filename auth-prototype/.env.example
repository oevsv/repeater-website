# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).
# Load it into the process environment at runtime (see README) — the values
# are read from the environment, this file is only a template.

# The confidential client secret. REQUIRED. Keep it off the repo and off the browser.
OIDC_CLIENT_SECRET=replace-with-the-real-secret

# A stable 32+ byte random hex string used to sign the session cookies.
# Generate once with:  openssl rand -hex 32
# If unset, a random key is used and sessions drop on every restart.
COOKIE_SECRET=replace-with-openssl-rand-hex-32

# --- The rest have sensible defaults for the oevsv realm; override only if needed.
# OIDC_ISSUER=https://id.oevsv.at/realms/oevsv
# OIDC_CLIENT_ID=oevsv.repeater
# OIDC_REDIRECT_URI=https://repeater.oevsv.at/authorized
# OIDC_POST_LOGOUT_URI=https://repeater.oevsv.at/
# OIDC_SCOPE=openid profile email
# PORT=8780
# COOKIE_SECURE=true          # set to false ONLY for local http testing
