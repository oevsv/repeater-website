# Template for the login service's configuration (environment variables).
# Never commit a filled-in copy.
#
# Production: the systemd unit repeater-auth.service sets the environment
# (see README), in one or both of two ways:
#
#   EnvironmentFile=/etc/repeater-auth.env
#     Loads a copy of this file. Use it for the secrets: make it readable
#     by root only (chmod 600).
#
#   Environment=NAME=value
#     One line per variable directly in the unit, e.g. Environment=PORT=8780.
#     Only for settings that are not secret: unit files and the output of
#     "systemctl show repeater-auth" can be read by every user on the server.
#
#   If a variable is set both ways, the value from EnvironmentFile wins.
#   After changing the unit run "systemctl daemon-reload"; after changing
#   either, run "systemctl restart repeater-auth".
#
# Local test runs: copy this file to .env next to server.js (gitignored) and
# load it into the shell, see README.
#
# Format: one NAME=value per line. Comments only on lines of their own,
# starting with the hash sign; text after a value would become part of the
# value (the service removes it, with a warning).

# The confidential client secret. REQUIRED. Keep it off the repo and off the browser.
OIDC_CLIENT_SECRET=replace-with-the-real-secret

# A stable 32+ byte random hex string used to sign the session cookies.
# Generate once with:  openssl rand -hex 32
# If unset, a random key is used and sessions drop on every restart.
COOKIE_SECRET=replace-with-openssl-rand-hex-32

# --- PostgREST: /api/secure BFF proxy and recording logins (users table) ---
# Shared secret: MUST equal PostgREST's jwt-secret, i.e. the contents of
# /etc/postgrest/jwt-secret (see repeater-db/README.md). 32+ chars.
# Without it /api/secure answers 503 and logins are not recorded.
PGRST_JWT_SECRET=replace-with-the-contents-of-etc-postgrest-jwt-secret

# The following have working defaults; uncomment a line only to change it.
#
# Where PostgREST listens (localhost only):
# PGRST_UPSTREAM=http://127.0.0.1:3000
#
# Postgres role the minted token maps to:
# PGRST_ROLE=web_user
#
# Lifetime in seconds of the token minted for each request:
# PGRST_TOKEN_TTL=30
#
# Prefix stripped before forwarding /api/secure/... (PostgREST serves tables at
# its root: /api/secure/whoami -> /whoami); unset forwards the path unchanged:
# PGRST_STRIP_PREFIX=/api/secure

# --- Keycloak / web page; defaults fit the oevsv realm ---
# OIDC_ISSUER=https://id.oevsv.at/realms/oevsv
# OIDC_CLIENT_ID=oevsv.repeater
# OIDC_REDIRECT_URI=https://repeater.oevsv.at/authorized
# OIDC_POST_LOGOUT_URI=https://repeater.oevsv.at/
# OIDC_SCOPE=openid profile email
# PORT=8780
#
# Secure flag on the cookies; false ONLY for local tests over http:
# COOKIE_SECURE=true
